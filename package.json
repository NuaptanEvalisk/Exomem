{
  "name": "exomem",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "concurrently -k 'tsx watch src/server/index.ts' 'vite --host 127.0.0.1'",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/server/index.js",
    "test": "tsx --test src/server/*.test.ts",
    "check": "tsc --noEmit",
    "backup": "tsx scripts/backup.ts"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@fastify/static": "^10.1.7",
    "@milkdown/crepe": "^7.22.3",
    "@milkdown/utils": "^7.22.3",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "antd": "^6.6.7",
    "better-sqlite3": "^13.0.3",
    "dayjs": "^1.11.23",
    "fastify": "^5.12.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "unicode-case-folding": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
